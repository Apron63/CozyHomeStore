<footer class="row clear">
	<div class="menu-footer">
		{% for item in footerMenu.menu1 %}
			{% if item.bold %}
				<h5><a href="{{ item.link }}" class="nondecor">{{ item.name }}</a></h5>
			{% else %}
				<p class="item-menu-footer"><a href="{{ item.link }}" class="nondecor">{{ item.name }}</a></p>
			{% endif %}
		{% endfor %}
	</div>

	<div class="menu-footer">
		{% for item in footerMenu.menu2 %}
			{% if item.bold %}
				<h5><a href="{{ item.link }}" class="nondecor">{{ item.name }}</a></h5>
			{% else %}
				<p class="item-menu-footer"><a href="{{ item.link }}" class="nondecor">{{ item.name }}</a></p>
			{% endif %}
		{% endfor %}
	</div>

    <div id="subscribe">
        <h5>Подписаться на рассылку</h5>
        <form id="mailing">
            <input class="left green" placeholder="E-mail" name="email">
            <button class="green" type="button" onclick="javascript:mailing();">Отправить</button>
        </form>
    </div>
</footer>

