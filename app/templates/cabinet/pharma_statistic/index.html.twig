{% extends 'cabinet.html.twig' %}

{% block title %}Кабинет Медико-фармацевтическое объединение{% endblock %}

{% block body %}
    <div class="content">
        <div class="wrapper">
	        <div class="row">
                <div class="subMenu">
                    <a href="{{ path('cabinet_pharma_statistic') }}" class="item-subMenu active">РАСЧЕТ ВЫПОЛНЕНИЯ АС</a>
