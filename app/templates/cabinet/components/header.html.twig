<span id="top"></span>
<header>
    <div class = "wrapper" >
        <div class="col-2"><a href="../" ><img src="../images/logo.png" id="logo"></a></div>
        <div class="col-2 fright">
            <a href="{{ path('app_logout') }}" class="nondecore exit">
                <p class="fleft">Выход&nbsp;</p> <p class="fleft"><img src="../images/exit.png"></p>
            </a>
        </div>
    </div>

    <div class="title">
	    <div class="wrapper">

            {% if user.roles.0 == 'ROLE_MULTI' %}
                <span class="multi-select">
                    <h1>{{ user.name }}</h1>
                    <p class="alert">выбрать юр. лицо</p>
                </span>
            {% else %}
                <h1>{{ user.name }}</h1>
            {% endif %}

            {% if user.name != '' %}
                <p>{{ user.name }}</p>
            {% endif %}

        </div>
    </div>

    <div class="wrapper breadcrumbs">
        {{ getBreadcrumbs(app.request.requestUri) }}
    </div>

</header>